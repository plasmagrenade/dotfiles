#!/bin/bash
# ABOUTME: Restores custom configs that omarchy migrations may overwrite.
# ABOUTME: Covers dotfiles symlinks, hypridle, and Plymouth boot screen.

# Warn when a dotfiles-managed ~/.config entry is no longer a symlink.
# `omarchy refresh <app>` moves the symlink aside and copies in defaults;
# merging drifted configs back into ~/.dotfiles is a manual decision.
for managed_dir in "$HOME/.dotfiles/configs/.config"/*/; do
    name=$(basename "$managed_dir")
    if [ ! -L "$HOME/.config/$name" ]; then
        echo "Warning: ~/.config/$name is no longer a symlink into ~/.dotfiles."
        echo "Diff it against $managed_dir, merge what you want to keep, then re-link with: bash ~/.dotfiles/scripts/replace.sh"
    fi
done

CONF="$HOME/.config/hypr/hypridle.conf"
CUSTOM="$HOME/.config/hypr/hypridle-custom.conf"

if ! grep -q 'IF_DISCHARGING' "$CONF"; then
    if [ -f "$CUSTOM" ]; then
        echo "hypridle.conf was overwritten by a migration — restoring from $CUSTOM"
        cp "$CUSTOM" "$CONF"
        omarchy-restart-hypridle
    else
        BACKUP=$(ls -t "$CONF".bak.* 2>/dev/null | head -1)
        if [ -n "$BACKUP" ]; then
            echo "hypridle.conf was overwritten by a migration — restoring from $BACKUP"
            cp "$BACKUP" "$CONF"
            omarchy-restart-hypridle
        else
            echo "Warning: hypridle.conf was overwritten and no backup found."
        fi
    fi
fi

# Restore custom Plymouth boot screen if omarchy update reset it to defaults.
# Custom background is pure black (0.000, 0.000, 0.000); omarchy default is Tokyo Night (0.101, 0.105, 0.149).
if ! grep -q "0.000, 0.000, 0.000" /usr/share/plymouth/themes/omarchy/omarchy.script; then
    echo "Plymouth was reset to defaults — restoring custom boot screen"
    omarchy-plymouth-set '#000000' '#ffffff' "$HOME/.config/omarchy/branding/logo.png"
fi
